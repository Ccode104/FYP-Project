import requests
import os
import base64
from urllib.parse import urlparse, parse_qs

cookies = {
    "oauthToken": "google$d6b5e00b-f9ab-4ca9-a540-cf8eb8d39b11",
    "gfguserName": "PASTE_FULL_VALUE",
    "gfg_e": "49fefc4d874d600831d4a3a0ac6cc3a1e9e4388498a327897b8df37d3d1ec6ae"
}

headers = {
    "User-Agent": "Mozilla/5.0",
    "Referer": "https://www.geeksforgeeks.org/"
}

urls = [
    # paste all your content-download links here
]

os.makedirs("downloads", exist_ok=True)

for url in urls:
    try:
        res = requests.get(url, cookies=cookies, headers=headers)

        if res.status_code == 200:
            parsed = urlparse(url)
            params = parse_qs(parsed.query)

            encoded_name = params.get("file_name", ["file.pdf"])[0]
            filename = base64.b64decode(encoded_name).decode()

            with open(f"downloads/{filename}", "wb") as f:
                f.write(res.content)

            print(f"Downloaded: {filename}")
        else:
            print(f"Failed: {res.status_code}")

    except Exception as e:
        print("Error:", e)